# Engram Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# LLM Configuration (Recommended: OpenAI-compatible)
# ===========================================

# OpenAI-compatible endpoint base URL
# Examples:
#   - Ollama (local): http://localhost:11434/v1
#   - Azure OpenAI: https://your-resource.openai.azure.com/openai/deployments/your-model/v1
#   - Other compatible: https://api.example.com/v1
LLM_ENDPOINT=https://dashscope-intl.aliyuncs.com/compatible-mode/v1/

# API key (empty for local endpoints like Ollama)
LLM_API_KEY=

# Model name to use
LLM_MODEL=qwen-plus

# Custom API paths (optional, defaults shown below)
# LLM_CHAT_PATH=chat/completions
# LLM_EMBEDDINGS_PATH=embeddings

# Rerank endpoint (optional)
# LLM_RERANK_ENDPOINT=https://api.example.com/rerank

# ===========================================
# Legacy: DashScope Configuration
# ===========================================
# Use LLM_ENDPOINT instead for OpenAI-compatible APIs
# ENGRAM_DASHSCOPE_API_KEY=your-dashscope-key

# Require LLM for chat (set to 'true' to fail if no LLM available)
ENGRAM_REQUIRE_LLM=false

# ===========================================
# Neo4j Configuration (Local Environment Only)
# ===========================================
# NOTE: Neo4j credentials are NOT managed via GitHub Secrets
# Configure these locally on your deployment server in .env
# They persist via docker-compose volumes and don't need frequent updates
ENGRAM_NEO4J_URI=http://neo4j:7474
ENGRAM_NEO4J_USER=neo4j
ENGRAM_NEO4J_PASSWORD=engram-memory
ENGRAM_NEO4J_DATABASE=neo4j

# ===========================================
# Server Configuration
# ===========================================
ENGRAM_SERVER_ADDR=0.0.0.0:3001
ENGRAM_DATA_DIR=/data

# MCP (Model Context Protocol) settings
ENGRAM_MCP_HTTP_ENABLED=true
ENGRAM_MCP_STDIO_ENABLED=true

# Logging level
RUST_LOG=warn