:80 {
	redir https://{host}{uri} permanent
}

:443 {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem

	# Grafana — proxy with full path preserved so Grafana knows its own sub-path
	handle /grafana* {
		reverse_proxy grafana:3000
	}

	# Engram app — catch-all
	reverse_proxy engram:3001
}
