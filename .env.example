# Copy this file to `.env` at the repo root or export these variables in your shell.

# Required for real Qwen-powered chat and consolidation.
ENGRAM_DASHSCOPE_API_KEY=

# Optional server bind address.
ENGRAM_SERVER_ADDR=127.0.0.1:3000

# Optional local data directory for the current file-backed memory stores.
# This controls where `.agent-memory/store/*` is written.
ENGRAM_DATA_DIR=.agent-memory

# Current status:
# - `crates/engram-store/src/qdrant.rs` is a local file-backed vector store stand-in.
# - `crates/engram-store/src/postgres.rs` is a local file-backed metadata store stand-in.
# - `crates/engram-store/src/oss.rs` is a local file-backed blob store stand-in.
#
# If you want, the next step is to replace these with real Qdrant/Postgres/S3 (or OSS) clients.
  